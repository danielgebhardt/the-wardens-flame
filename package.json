{
  "name": "larn-remake",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "prepare": "husky",
    "frontend:dev": "pnpm --filter frontend dev",
    "frontend:build": "pnpm --filter frontend run build",
    "frontend:check": "pnpm --filter frontend run check",
    "frontend:typecheck": "pnpm --filter frontend run typecheck",
    "frontend:check:fix": "pnpm --filter frontend run check:fix",
    "frontend:test": "pnpm --filter frontend run test:run",
    "frontend:smoke": "pnpm --filter frontend run test:smoke",
    "frontend:android:build": "pnpm --filter frontend run android:build",
    "frontend:android:apk": "pnpm --filter frontend run android:apk",
    "frontend:webapp:build": "pnpm --filter frontend run webapp:build",
    "frontend:ios": "pnpm --filter frontend run ios"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
